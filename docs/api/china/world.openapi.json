          }
        },
        "description": "世界列表分页结果：含本次请求的 `pageNum` / `pageSize`，以及当前页数据与总计。"
      },
      "WorldSemanticsMetadata": {
        "type": "object",
        "properties": {
          "upAxis": {
            "$ref": "#/components/schemas/WorldOpenApiUpAxis"
          }
        },
        "description": "语义元数据（相机位姿、比例、偏移、坐标系约定等）。任务成功且返回 splat 产物时，应包含 upAxis 以标明坐标系。"
      },
      "WorldSplatBundle": {
        "type": "object",
        "properties": {
          "urls": {
            "$ref": "#/components/schemas/SplatFileUrls"
          }
        },
        "description": "3DGS splat 输出文件集合。"
      },
      "GenerateWorldRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "项目 / 世界展示名称",
            "example": "客厅生成"
          },
          "cover": {
            "type": "string",
            "description": "封面图 URL；可选。",
            "example": "https://cdn.example.com/cover/gen-cover.jpg"
          },
          "resources": {
            "type": "array",
            "description": "输入资源列表；与 prompt 至少满足其一。仅支持图片，至多 1 条；未传 type 时按图片处理。image：.jpg / .jpeg / .png / .webp。",
            "items": {
              "$ref": "#/components/schemas/GenerateWorldResourceItem"
            }
          },
          "prompt": {
            "type": "string",
            "description": "文本提示词；可与 resources 同时提供。",
            "example": "现代简约风格，阳光充足的客厅"
          }
        },
        "description": "创建 3DGS「生成世界」任务的请求体；支持纯文案、单张图片或图文组合。室内场景效果更成熟；非室内为 Beta（详见同路径 POST 说明）。\n至少需提供非空 prompt 或至少一条图片资源（至多 1 张）；image：.jpg / .jpeg / .png / .webp。"
      },
      "GenerateWorldResourceItem": {
        "required": [
          "url"
        ],
        "type": "object",
        "properties": {
          "url": {
            "minLength": 1,
            "type": "string",
            "description": "图片资源 URL；扩展名须为 image：.jpg / .jpeg / .png / .webp。",
            "example": "https://cdn.example.com/input/room.jpg"
          },
          "type": {
            "$ref": "#/components/schemas/WorldOpenApiGenResourceType"
          }
        },
        "description": "生成任务单条输入资源（图片）。未传 `type` 时按图片处理。image：.jpg / .jpeg / .png / .webp。"
      },
      "WorldOpenApiGenResourceType": {
        "type": "string",
        "description": "生成任务输入资源类型，仅支持 image（图片），支持 .jpg / .jpeg / .png / .webp。",
        "example": "image",
        "enum": [
          "image"
        ]
      }
    },
    "securitySchemes": {
      "AuthorizationHeader": {
        "type": "apiKey",
        "description": "开放平台访问凭证。API key 鉴权,在 Header 中增加 Authorization，值为平台申请的 API key，无需 Bearer 前缀。",
        "name": "Authorization",
        "in": "header"
      }
    }
  }
