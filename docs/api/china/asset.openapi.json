      "OusTokenV2": {
        "type": "apiKey",
        "description": "由「获取 OUS 上传凭证」返回的 `ousToken`；仅用于请求 `globalDomain` 上的 OUS 接口（与开放平台 `Authorization` 无关）。",
        "name": "ous-token-v2",
        "in": "header"
      }
