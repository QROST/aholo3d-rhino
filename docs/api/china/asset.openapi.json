          },
          "d": {
            "$ref": "#/components/schemas/OusV2SingleUploadData"
          }
        },
        "description": "单文件上传 200 响应体（`c` 为 `0` 时 `d` 含 taskId）。"
      },
      "OusV2BlockPartApiResponse": {
        "required": [
          "c",
          "d"
        ],
        "type": "object",
        "properties": {
          "c": {
            "type": "string",
            "description": "业务状态码，成功为 `0`。",
            "example": "0"
          },
          "m": {
            "type": "string",
            "description": "提示信息；可为空字符串。"
