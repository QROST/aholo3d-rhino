<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <TargetExt>.rhp</TargetExt>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Description>Aholo for Rhino by CuriousArc and qrost. World generation, experimental native Gaussian splat display and RenderCloud rendering. Independent integration requiring an Aholo API Key.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RhinoCommon" IncludeAssets="compile;build" PrivateAssets="all" />
    <ProjectReference Include="../Aholo.Core/Aholo.Core.csproj" />
    <None Include="../../assets/gaussian-opacity-atlas.png" Link="assets/gaussian-opacity-atlas.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../assets/gaussian-alpha.png" Link="assets/gaussian-alpha.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../scripts/usd_mesh_bridge.py" Link="usd/usd_mesh_bridge.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../scripts/usd_bridge.py" Link="usd/usd_bridge.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
