#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)
# CuriousArc / qrost. Compare faceted and explicitly smooth corners, plus a concave quad.
def Xform "World"
{
    def Mesh "FacetedCorner"
    {
        uniform token subdivisionScheme = "none"
        point3f[] points = [(0, 0, 0), (2, 0, 0), (0, 2, 0), (0, 0, 2)]
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 0, 3, 1]
        color3f[] primvars:displayColor = [(0.05, 0.3, 0.8)] (interpolation = "constant")
    }
    def Mesh "AuthoredSmoothCorner"
    {
        uniform token subdivisionScheme = "none"
        point3f[] points = [(0, 0, 0), (2, 0, 0), (0, 2, 0), (0, 0, 2)]
        int[] faceVertexCounts = [3, 3]
        int[] faceVertexIndices = [0, 1, 2, 0, 3, 1]
        normal3f[] normals = [(0, 0.70710678, 0.70710678), (0, 0.70710678, 0.70710678), (0, 0, 1), (0, 1, 0)] (interpolation = "vertex")
        color3f[] primvars:displayColor = [(0.05, 0.3, 0.8)] (interpolation = "constant")
        double3 xformOp:translate = (3, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Mesh "ConcaveQuad"
    {
        uniform token subdivisionScheme = "none"
        point3f[] points = [(4, 0, 0), (0, 1, 0), (1, 0, 0), (0, -1, 0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        color3f[] primvars:displayColor = [(0.8, 0.1, 0.03)] (interpolation = "constant")
        double3 xformOp:translate = (0, 4, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
